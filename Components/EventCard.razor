@using EventEase.Models
@using EventEase.Services
@inject NavigationManager Navigation

<div class="card h-100 shadow-sm border-0 event-card transition-all">
    <div class="position-relative">
        <img src="@Event.ImageUrl" class="card-img-top event-img" alt="@Event.Title" style="height: 190px; object-fit: cover;" />
        <span class="badge bg-primary position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill shadow-sm">
            @Event.Category
        </span>
    </div>
    <div class="card-body d-flex flex-column">
        @if (isEditing)
        {
            <!-- Two-Way Data Binding Interactive Edit Mode (Generated with Copilot assistance) -->
            <div class="mb-3 p-3 bg-light border rounded-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <small class="text-primary fw-bold">
                        <i class="bi bi-pencil-square me-1"></i> Two-Way Binding Edit Mode
                    </small>
                    <span class="badge bg-info text-dark">Live Update</span>
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold mb-0">Event Title:</label>
                    <input class="form-control form-control-sm" @bind="Event.Title" @bind:event="oninput" />
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold mb-0">Location:</label>
                    <input class="form-control form-control-sm" @bind="Event.Location" @bind:event="oninput" />
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold mb-0">Max Capacity:</label>
                    <input type="number" class="form-control form-control-sm" @bind="Event.Capacity" />
                </div>
                <button class="btn btn-sm btn-success w-100 mt-1" @onclick="SaveEdit">
                    <i class="bi bi-check-circle me-1"></i> Save Changes
                </button>
            </div>
        }
        else
        {
            <h5 class="card-title fw-bold text-dark mb-2">@Event.Title</h5>
            <p class="card-text text-muted small flex-grow-1">@Event.Description</p>
        }

        <ul class="list-unstyled small mb-3">
            <li class="mb-2 text-secondary">
                <i class="bi bi-calendar3 me-2 text-primary"></i>
                @Event.Date.ToString("ddd, MMM dd, yyyy - hh:mm tt")
            </li>
            <li class="mb-2 text-secondary">
                <i class="bi bi-geo-alt-fill me-2 text-danger"></i>
                @Event.Location
            </li>
            <li class="mb-2 text-secondary d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-people-fill me-2 text-success"></i>
                    @Event.RegisteredCount / @Event.Capacity attendees
                </span>
                @if (Event.IsSoldOut)
                {
                    <span class="badge bg-danger">Sold Out</span>
                }
                else
                {
                    <span class="badge bg-success bg-opacity-75">@Event.AvailableSeats seats left</span>
                }
            </li>
        </ul>

        <!-- Capacity Progress Bar -->
        <div class="progress mb-3" style="height: 6px;">
            <div class="progress-bar @(Event.IsSoldOut ? "bg-danger" : "bg-primary")" 
                 role="progressbar" 
                 style="width: @(Event.Capacity > 0 ? Math.Min(100, (double)Event.RegisteredCount / Event.Capacity * 100) : 0)%;">
            </div>
        </div>

        <div class="mt-auto d-flex gap-2">
            <a href="events/@Event.Id" class="btn btn-outline-primary btn-sm flex-fill">
                <i class="bi bi-eye me-1"></i> Details
            </a>
            <button class="btn btn-primary btn-sm flex-fill" 
                    disabled="@Event.IsSoldOut" 
                    @onclick="GoToRegister">
                <i class="bi bi-ticket-perforated me-1"></i> Register
            </button>
            <button class="btn btn-outline-secondary btn-sm" 
                    title="Toggle Two-Way Binding Edit Mode" 
                    @onclick="ToggleEdit">
                <i class="bi @(isEditing ? "bi-x-lg" : "bi-pencil")"></i>
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventItem Event { get; set; } = new();

    [Parameter]
    public EventCallback<EventItem> EventChanged { get; set; }

    private bool isEditing = false;

    private void ToggleEdit()
    {
        isEditing = !isEditing;
    }

    private async Task SaveEdit()
    {
        isEditing = false;
        await EventChanged.InvokeAsync(Event);
    }

    private void GoToRegister()
    {
        Navigation.NavigateTo($"register?eventId={Event.Id}");
    }
}
