<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="container text-center py-5">
                <div class="card shadow-sm p-5 border-danger border-2 mx-auto" style="max-width: 600px;">
                    <div class="display-1 text-danger mb-3">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <h2 class="text-danger fw-bold">404 - Page Not Found</h2>
                    <p class="text-muted lead">The page or event route you are looking for does not exist or has been moved.</p>
                    <div class="mt-4">
                        <a href="" class="btn btn-primary px-4 me-2">Return to Home</a>
                        <a href="events" class="btn btn-outline-secondary px-4">Browse Events</a>
                    </div>
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>
