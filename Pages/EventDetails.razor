@page "/events/{Id:int}"
@using EventEase.Models
@using EventEase.Services
@inject EventSessionStateService StateService
@inject NavigationManager Navigation

<PageTitle>@(currentEvent != null ? currentEvent.Title : "Event Details") - EventEase</PageTitle>

@if (currentEvent == null)
{
    <!-- Route error / missing parameter optimization -->
    <div class="card shadow-sm border-warning p-5 text-center my-4 mx-auto" style="max-width: 600px;">
        <i class="bi bi-calendar-x text-warning display-3 mb-3"></i>
        <h3 class="fw-bold text-dark">Event Not Found</h3>
        <p class="text-muted">No event with ID #@Id exists in the EventEase system.</p>
        <div class="mt-3">
            <a href="events" class="btn btn-primary px-4">Back to Events Directory</a>
        </div>
    </div>
}
else
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="">Home</a></li>
            <li class="breadcrumb-item"><a href="events">Events</a></li>
            <li class="breadcrumb-item active" aria-current="page">@currentEvent.Title</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-0 overflow-hidden mb-4">
        <div class="row g-0">
            <div class="col-lg-5">
                <img src="@currentEvent.ImageUrl" alt="@currentEvent.Title" class="img-fluid w-100 h-100" style="object-fit: cover; min-height: 320px;" />
            </div>
            <div class="col-lg-7 p-4 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-primary px-3 py-2 rounded-pill">@currentEvent.Category</span>
                        <span class="badge @(currentEvent.IsSoldOut ? "bg-danger" : "bg-success") px-3 py-2">
                            @(currentEvent.IsSoldOut ? "Sold Out" : $"{currentEvent.AvailableSeats} Seats Remaining")
                        </span>
                    </div>

                    <h2 class="fw-bold text-dark mb-3">@currentEvent.Title</h2>
                    <p class="text-secondary lead fs-6 mb-4">@currentEvent.Description</p>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center p-2 rounded bg-light">
                                <i class="bi bi-calendar3 text-primary fs-4 me-3"></i>
                                <div>
                                    <small class="text-muted d-block">Date & Time</small>
                                    <strong class="text-dark">@currentEvent.Date.ToString("f")</strong>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center p-2 rounded bg-light">
                                <i class="bi bi-geo-alt-fill text-danger fs-4 me-3"></i>
                                <div>
                                    <small class="text-muted d-block">Location</small>
                                    <strong class="text-dark">@currentEvent.Location</strong>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center p-2 rounded bg-light">
                                <i class="bi bi-people-fill text-success fs-4 me-3"></i>
                                <div>
                                    <small class="text-muted d-block">Attendance</small>
                                    <strong class="text-dark">@currentEvent.RegisteredCount / @currentEvent.Capacity</strong>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center p-2 rounded bg-light">
                                <i class="bi bi-shield-check text-info fs-4 me-3"></i>
                                <div>
                                    <small class="text-muted d-block">Routing Parameter</small>
                                    <strong class="text-dark">Event ID: @Id</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary px-4" disabled="@currentEvent.IsSoldOut" @onclick="NavigateToRegister">
                        <i class="bi bi-ticket-perforated me-1"></i> Register for this Event
                    </button>
                    <a href="events" class="btn btn-outline-secondary px-3">
                        <i class="bi bi-arrow-left me-1"></i> All Events
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private EventItem? currentEvent;

    protected override void OnParametersSet()
    {
        currentEvent = StateService.Events.FirstOrDefault(e => e.Id == Id);
    }

    private void NavigateToRegister()
    {
        if (currentEvent != null)
        {
            Navigation.NavigateTo($"register?eventId={currentEvent.Id}");
        }
    }
}
