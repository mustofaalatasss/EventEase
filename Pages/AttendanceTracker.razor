@page "/attendance"
@using EventEase.Models
@using EventEase.Services
@inject EventSessionStateService StateService

<PageTitle>EventEase - Attendance Tracker</PageTitle>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold text-dark mb-1">Attendance Tracker</h2>
        <p class="text-muted mb-0">Real-time attendance monitor with state-synchronized check-in toggles.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="register" class="btn btn-outline-primary">
            <i class="bi bi-person-plus me-1"></i> Register New Attendee
        </a>
    </div>
</div>

<!-- Attendance Statistics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm p-3 bg-white text-center">
            <small class="text-muted text-uppercase fw-bold">Total Registered</small>
            <h3 class="fw-bold text-dark mt-1 mb-0">@StateService.Attendees.Count</h3>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm p-3 bg-white text-center">
            <small class="text-muted text-uppercase fw-bold">Checked In</small>
            <h3 class="fw-bold text-success mt-1 mb-0">@CheckedInCount</h3>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm p-3 bg-white text-center">
            <small class="text-muted text-uppercase fw-bold">Pending Check-In</small>
            <h3 class="fw-bold text-warning mt-1 mb-0">@(StateService.Attendees.Count - CheckedInCount)</h3>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm p-3 bg-white text-center">
            <small class="text-muted text-uppercase fw-bold">Check-In Rate</small>
            <h3 class="fw-bold text-primary mt-1 mb-0">
                @(StateService.Attendees.Count > 0 ? $"{(int)((double)CheckedInCount / StateService.Attendees.Count * 100)}%" : "0%")
            </h3>
        </div>
    </div>
</div>

<!-- Search & Filter Controls -->
<div class="card border-0 shadow-sm p-3 mb-4 bg-white">
    <div class="row g-3">
        <div class="col-md-7">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text" class="form-control border-start-0" 
                       placeholder="Filter attendees by name, email, or event title..." 
                       @bind="searchQuery" 
                       @bind:event="oninput" />
            </div>
        </div>
        <div class="col-md-5">
            <select class="form-select" @bind="statusFilter">
                <option value="All">All Statuses (Checked-in & Pending)</option>
                <option value="CheckedIn">Checked In Only</option>
                <option value="Pending">Pending Only</option>
            </select>
        </div>
    </div>
</div>

<!-- Attendees Table -->
<div class="card border-0 shadow-sm overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="py-3 ps-4">Attendee Name</th>
                    <th scope="col" class="py-3">Email Address</th>
                    <th scope="col" class="py-3">Event Assigned</th>
                    <th scope="col" class="py-3 text-center">Tickets</th>
                    <th scope="col" class="py-3">Status</th>
                    <th scope="col" class="py-3 text-end pe-4">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (FilteredAttendees.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            No attendee records match the filter criteria.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var attendee in FilteredAttendees)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">
                                <i class="bi bi-person-circle text-secondary me-2"></i>
                                @attendee.FullName
                            </td>
                            <td class="text-muted small">@attendee.Email</td>
                            <td class="small">
                                <span class="badge bg-light text-dark border">@attendee.EventTitle</span>
                            </td>
                            <td class="text-center fw-bold">@attendee.Tickets</td>
                            <td>
                                @if (attendee.IsCheckedIn)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">
                                        <i class="bi bi-check2-circle me-1"></i> Checked In
                                    </span>
                                    <div class="text-muted" style="font-size: 0.75rem;">
                                        @(attendee.CheckInTime?.ToString("hh:mm tt") ?? "Recently")
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-1">
                                        <i class="bi bi-clock me-1"></i> Pending
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm @(attendee.IsCheckedIn ? "btn-outline-danger" : "btn-success")"
                                        @onclick="@(() => StateService.ToggleAttendance(attendee.Id))">
                                    <i class="bi @(attendee.IsCheckedIn ? "bi-arrow-counterclockwise" : "bi-check-lg") me-1"></i>
                                    @(attendee.IsCheckedIn ? "Undo Check-In" : "Check In")
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private string searchQuery = string.Empty;
    private string statusFilter = "All";

    private int CheckedInCount => StateService.Attendees.Count(a => a.IsCheckedIn);

    private List<Attendee> FilteredAttendees => StateService.Attendees
        .Where(a => (statusFilter == "All" 
                    || (statusFilter == "CheckedIn" && a.IsCheckedIn)
                    || (statusFilter == "Pending" && !a.IsCheckedIn))
                 && (string.IsNullOrWhiteSpace(searchQuery)
                    || a.FullName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                    || a.Email.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                    || a.EventTitle.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    protected override void OnInitialized()
    {
        StateService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        StateService.OnChange -= StateHasChanged;
    }
}
