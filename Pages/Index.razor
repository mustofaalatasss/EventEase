@page "/"
@using EventEase.Services
@inject EventSessionStateService StateService

<PageTitle>EventEase - Home & Dashboard</PageTitle>

<!-- Hero Section -->
<div class="p-5 mb-4 bg-white rounded-3 shadow-sm border border-light">
    <div class="container-fluid py-2">
        <span class="badge bg-primary bg-opacity-10 text-primary mb-2 px-3 py-2 fw-semibold">
            <i class="bi bi-robot me-1"></i> Developed with Microsoft Copilot AI
        </span>
        <h1 class="display-5 fw-bold text-dark">Welcome to EventEase</h1>
        <p class="col-md-9 fs-5 text-muted">
            A comprehensive Blazor web application featuring interactive components, two-way data binding,
            client-side routing, advanced form validation, and reactive user session state management.
        </p>
        <div class="d-flex flex-wrap gap-2 mt-3">
            <a href="events" class="btn btn-primary btn-lg px-4">
                <i class="bi bi-calendar-event me-2"></i> Explore Events
            </a>
            <a href="register" class="btn btn-outline-secondary btn-lg px-4">
                <i class="bi bi-pen me-2"></i> Register Now
            </a>
            <a href="attendance" class="btn btn-outline-success btn-lg px-4">
                <i class="bi bi-person-check me-2"></i> Attendance Tracker
            </a>
        </div>
    </div>
</div>

<!-- Quick Statistics Banner -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 bg-white">
            <div class="d-flex align-items-center">
                <div class="rounded-3 p-3 bg-primary bg-opacity-10 text-primary me-3">
                    <i class="bi bi-calendar3 fs-3"></i>
                </div>
                <div>
                    <h6 class="text-muted small mb-0">Total Active Events</h6>
                    <h3 class="fw-bold mb-0">@StateService.Events.Count</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 bg-white">
            <div class="d-flex align-items-center">
                <div class="rounded-3 p-3 bg-success bg-opacity-10 text-success me-3">
                    <i class="bi bi-person-badge fs-3"></i>
                </div>
                <div>
                    <h6 class="text-muted small mb-0">Registered Attendees</h6>
                    <h3 class="fw-bold mb-0">@StateService.Attendees.Count</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 bg-white">
            <div class="d-flex align-items-center">
                <div class="rounded-3 p-3 bg-warning bg-opacity-10 text-warning me-3">
                    <i class="bi bi-check-circle-fill fs-3"></i>
                </div>
                <div>
                    <h6 class="text-muted small mb-0">Checked-In Ratio</h6>
                    <h3 class="fw-bold mb-0">
                        @(StateService.Attendees.Count > 0 
                            ? $"{(int)((double)StateService.Attendees.Count(a => a.IsCheckedIn) / StateService.Attendees.Count * 100)}%" 
                            : "0%")
                    </h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Featured Events Section -->
<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold text-dark mb-0">Featured Events</h4>
        <a href="events" class="text-primary text-decoration-none fw-semibold">View All <i class="bi bi-arrow-right"></i></a>
    </div>
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var ev in StateService.Events.Take(3))
        {
            <div class="col">
                <EventCard Event="@ev" EventChanged="@(() => StateService.UpdateEvent(ev))" />
            </div>
        }
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        StateService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        StateService.OnChange -= StateHasChanged;
    }
}
